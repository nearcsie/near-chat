# Copy this file to .env.test before running integration tests.
#
# Every active value here is an *in-container* address, because the documented
# flow runs the suite inside the backend container (`docker compose exec backend
# ...`). `bun test` loads this file whatever NODE_ENV is set to, and a real
# environment variable still wins over it — which is how ci-database.yml points
# the same suite at its own services without editing anything here.

# db-test is the service name in docker-compose.yml (test profile) — reachable from the backend container.
DATABASE_URL_TEST=postgresql://postgres:postgres@db-test:5432/ntnu_test
# Running the suite on the host instead? Use the published mapping:
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5436/ntnu_test

# redis is the service name in docker-compose.yml — reachable from the backend
# container, where nothing listens on the host-side 6385. Needs Redis 7.4+ for
# the per-field TTLs presenceStore relies on; the compose service ships
# redis:8-alpine, so the documented flow is already above that floor.
REDIS_URL_TEST=redis://redis:6379
# Running the suite on the host instead? Use the published mapping:
# REDIS_URL_TEST=redis://localhost:6385
