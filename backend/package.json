{
  "name": "near-chat-backend",
  "version": "2.1.1",
  "description": "Bun + Hono backend API for Near Chat",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "migrate:up": "bun src/models/migrate.ts up",
    "migrate:down": "bun src/models/migrate.ts down",
    "migrate:create": "bun src/models/migrate.ts create",
    "test": "bun test tests/unit && bun test tests/integration && bun test tests/e2e",
    "db:seed": "bun src/models/seed.ts",
    "test:unit": "bun test tests/unit",
    "test:coverage": "COLLECT_BRANCH_COVERAGE=true bun test tests/unit && bun scripts/reportCoverage.ts",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:e2e:local": "pnpm run test:db:up && bun test tests/e2e",
    "test:db:up": "docker compose -f ../docker-compose.yml up -d --wait db-test redis && pnpm run migrate:test",
    "test:db:down": "docker compose -f ../docker-compose.yml stop db-test && docker compose -f ../docker-compose.yml rm -f db-test",
    "migrate:test": "bun src/models/migrate.ts up --database-url=postgresql://postgres:postgres@localhost:5436/ntnu_test",
    "lint": "eslint src && tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@socket.io/bun-engine": "^0.1.2",
    "hono": "^4.13.8",
    "hono-rate-limiter": "^0.5.4",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-adapter": "~2.5.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@types/babel__core": "^7.20.5",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^22.20.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "bun-types": "^1.4.2",
    "eslint": "^10.8.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^6.0.3"
  }
}
